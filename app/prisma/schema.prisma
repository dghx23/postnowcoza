generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

// Gates Deal payout, not Deal creation — a user can be added to a deal as
// seller immediately, but the RELEASED transition additionally requires
// kycStatus == VERIFIED. See BACKEND_DESIGN.md §6.
enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  UPLOADED
  QUEUED_FOR_PRINT
  PRINTED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  RETURN_REQUESTED
  RETURN_IN_TRANSIT
  RETURNED
}

enum ShipmentDirection {
  OUTBOUND
  RETURN
}

enum SubmissionStatus {
  PENDING_RATES
  PENDING_SUBMISSION
  SUCCESS
  NO_RATES
  FAILED_WILL_RETRY
  FAILED_INDEFINITELY
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  CANCELLED
  REFUNDED
  /// Staff processed this job at no cost (at PostNow's expense) - dispatch
  /// proceeds as if paid, but it's tracked separately for the finance
  /// review queue rather than as real revenue.
  WAIVED
}

enum ReturnPreference {
  DIRECT
  MANAGED
}

enum FeaturePriority {
  HIGH
  MEDIUM
  LOW
}

enum FeatureStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  IMPLEMENTED
}

// EPSON is the OAuth-based Epson Connect cloud API (src/lib/epson.ts).
// EPSON_DIRECT is Epson's "Email Print" feature - printing by emailing a
// PDF straight to the printer's own assigned address, with no OAuth app
// registration required at all.
enum PrintProvider {
  EPSON
  EPSON_DIRECT
}

enum CourierBookingStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  COURIER_ASSIGNED
  COLLECTED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum CourierBookingPickupType {
  DOOR
  LOCKER
  BUSINESS
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  consentedAt  DateTime?
  /// Required before a Deal can move to RELEASED and pay this user out as a
  /// seller. Deal creation itself doesn't require it — only payout does.
  kycStatus    KycStatus @default(UNVERIFIED)
  createdAt    DateTime  @default(now())

  documents     Document[]
  auditEvents   AuditEvent[]
  dealsAsBuyer  Deal[]       @relation("DealBuyer")
  dealsAsSeller Deal[]       @relation("DealSeller")
}

model Document {
  id               String         @id @default(cuid())
  ownerId          String
  owner            User           @relation(fields: [ownerId], references: [id])
  status           DocumentStatus @default(UPLOADED)
  storageKey       String
  checksum         String
  encryptionKeyRef String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Delivery address for this document. One address per document keeps this
  // simple; a customer with multiple documents can have different addresses
  // on each rather than needing a shared address book.
  recipientName  String
  recipientPhone String
  recipientEmail String
  streetAddress  String
  localArea      String
  city           String
  zone           String
  postalCode     String
  country        String @default("ZA")

  // Option A (Direct) vs Option B (Fully Managed) from the return pathway
  // the customer chose at submission time.
  returnPreference ReturnPreference @default(MANAGED)

  // Print preferences chosen by the customer at dispatch (honoured by
  // Epson Connect Print EpsonAPI; staff can override in the print dialog).
  // colorMode: mono | color. copies: 1–10.
  printColorMode String @default("mono")
  printCopies    Int    @default(1)

  // Who created the job: staff manual entry vs customer/portal self-serve.
  // staffCreatorEmail is set when createdVia is STAFF (for tracking badge).
  createdVia        String  @default("CUSTOMER") // STAFF | CUSTOMER | PORTAL
  staffCreatorEmail String?

  // Courier rate charged for the outbound dispatch, set once a shipment is
  // booked (src/lib/dispatch.ts). The dispatch fee payment is created from
  // this amount, not recomputed at payment time.
  dispatchFee Float?

  auditEvents    AuditEvent[]
  bobgoShipments BobgoShipment[]
  payments       Payment[]
  epsonPrintJobs EpsonPrintJob[]
  subscribers    DocumentSubscriber[]
}

// Someone (besides the owner) who was sent this booking and opted in to
// receive future status updates by email or WhatsApp. notifyDocumentSubscribers
// (src/lib/documentSharing.ts) fans out to these rows on every status change,
// hooked in once at appendAuditEvent so every call site gets it for free.
model DocumentSubscriber {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  channel     String // "email" | "whatsapp"
  destination String
  createdAt   DateTime @default(now())

  @@index([documentId])
}

// Append-only chain-of-custody log. Rows are never updated or deleted from
// application code; `prevHash`/`hash` form a tamper-evident chain.
//
// Originally Document-only (E2). documentId/dealId are both optional so a
// row belongs to exactly one owner — enforced by the CHECK constraint added
// in migration 20260131000000_midl_deal_model, not by Prisma itself (Prisma
// has no native polymorphic-relation support, so this is two nullable FKs
// rather than a single entityType/entityId pair).
model AuditEvent {
  id         String    @id @default(cuid())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])
  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id])
  action     String
  metadata   Json?
  ip         String?
  prevHash   String?
  hash       String
  createdAt  DateTime  @default(now())

  @@index([documentId])
  @@index([dealId])
}

// One row per courier shipment attempt — an OUTBOUND dispatch and, later, a
// RETURN each get their own row so both legs of the chain-of-custody are
// independently trackable. Same optional-dual-FK note as AuditEvent above:
// exactly one of documentId/dealId is set per row (E2 vs. Midl), enforced
// by a DB CHECK constraint, not by Prisma.
model BobgoShipment {
  id                String            @id @default(cuid())
  documentId        String?
  document          Document?         @relation(fields: [documentId], references: [id])
  dealId            String?
  deal              Deal?             @relation(fields: [dealId], references: [id])
  direction         ShipmentDirection
  bobgoOrderId      Int?
  providerSlug      String?
  serviceLevelCode  String?
  trackingReference String?           @unique
  submissionStatus  SubmissionStatus  @default(PENDING_RATES)
  trackingStatus    String?
  failedReason      String?
  waybillUrl        String?
  podUrl            String?
  rawPayload        Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([documentId])
  @@index([dealId])
}

// Internal staff-only feature/roadmap tracker - not part of the customer-
// facing product or the chain-of-custody audit trail, just a lightweight
// planning tool.
model Feature {
  id        String          @id @default(cuid())
  name      String
  priority  FeaturePriority @default(MEDIUM)
  status    FeatureStatus   @default(NOT_STARTED)
  comment   String?
  checked   Boolean         @default(false)
  createdBy String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

// Epson's API has no "list all jobs" endpoint, only lookup by ID - this
// records every job we create so status.ts can poll each one individually
// to build a pending-jobs count instead of asking Epson for a list.
// Detail columns log customer request vs settings actually sent to the printer
// (audit trail + customer tracking visibility).
model EpsonPrintJob {
  id                String    @id @default(cuid())
  documentId        String
  document          Document  @relation(fields: [documentId], references: [id])
  jobId             String    @unique
  status            String    @default("pending")
  /// epson_connect | epson_direct | manual_mark
  via               String?
  submittedById     String?
  customerColorMode String?
  customerCopies    Int?
  printedColorMode  String?
  printedCopies     Int?
  /// Full JobPrintSettings payload sent (or intended) to the printer
  printSettings     Json?
  /// Webhook / email outcome payload summary
  outcomeDetail     Json?
  confirmedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([documentId])
}

// Singleton row (id is always the fixed string "singleton") holding the
// staff-configurable choice of which print backend the print queue's
// "Print (API)" button uses, plus the destination address for EPSON_DIRECT,
// and (when Epson Connect OAuth has succeeded) the shared device tokens.
// Read/written via /api/print-settings and src/lib/epson.ts.
model PrintSettings {
  id                  String        @id @default("singleton")
  provider            PrintProvider @default(EPSON)
  epsonDirectEmail    String?
  // Device tokens from OAuth authorization_code / refresh — server-side so
  // any staff browser and any serverless invocation can print/status-check.
  epsonAccessToken    String?
  epsonRefreshToken   String?
  epsonTokenExpiresAt DateTime?
  // Facility default job settings (manual adjusters on Printer Hub).
  // Customer-chosen color/copies live on Document; staff may override at print.
  printPaperSize      String        @default("ps_a4")
  printPaperType      String        @default("pt_plainpaper")
  printQuality        String        @default("normal")
  printPaperSource    String        @default("rear")
  printBorderless     Boolean       @default(false)
  printDoubleSided    String        @default("none")
  updatedAt           DateTime      @updatedAt
}

// A Bob Pay payment intent for a document's dispatch fee.
model Payment {
  id                     String        @id @default(cuid())
  documentId             String
  document               Document      @relation(fields: [documentId], references: [id])
  customPaymentId        String        @unique
  bobpayUuid             String?
  amount                 Float
  status                 PaymentStatus @default(UNPAID)
  paymentMethod          String?
  paymentUrl             String?
  rawPayload             Json?
  // Zoho Books mapping (invoice + contact + customer payment)
  zohoBooksInvoiceId     String?
  zohoBooksContactId     String?
  zohoBooksPaymentId     String?
  zohoBooksSyncedAt      DateTime?
  zohoBooksSyncError     String?
  /// Last known Zoho invoice status from pull (paid | sent | overdue | …)
  zohoBooksInvoiceStatus String?
  /// Outstanding balance on the Zoho invoice (if any)
  zohoBooksBalance       Float?
  zohoBooksLastPullAt    DateTime?
  /// Optional link to a BillingItem used for this fee line
  billingItemId          String?
  billingItem            BillingItem?  @relation(fields: [billingItemId], references: [id])

  // Manual-entry accountability (staff-created documents only, captured on
  // the "Request payment of dispatch fee" screen before send/cancel/waive).
  manualEntryJustification String?
  isTestEntry              Boolean @default(false)
  cancelledJustification   String?
  /// Set when staff processes this job at no cost - the exact loss amount,
  /// entered and confirmed on that screen, for the finance review queue.
  waivedAmount             Float?
  waivedJustification      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId])
  @@index([billingItemId])
}

// Staff-editable payment structure / rate lines that feed dispatch fees
// and eventually Zoho Books line items. Workspace on /finance.
model BillingItem {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  /// Default ZAR amount for this billing line
  amount      Float
  /// Optional Zoho Books item_id when mapped
  zohoItemId  String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
}

// Two-way Zoho ↔ PostNow (and payment-structure) exception log
model SyncException {
  id         String    @id @default(cuid())
  source     String // zoho_push | zoho_pull | payment_structure | other
  severity   String    @default("error") // error | warn | info
  title      String
  detail     String?
  paymentId  String?
  documentId String?
  metadata   Json?
  resolved   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolved, createdAt])
  @@index([source])
}

// A courier booking made through the WhatsApp bot (distinct from the E2
// document-dispatch product): sender books a pickup, pays instantly via
// PayShap Request-to-Pay, and both sender + recipient get WhatsApp
// tracking updates. See src/lib/whatsappBookingBot.ts for the conversation
// state machine and src/lib/payshap.ts for the payment integration.
model CourierBooking {
  id         String               @id @default(cuid())
  bookingRef String               @unique // e.g. PN-2026-1234
  status     CourierBookingStatus @default(DRAFT)

  senderPhone   String // WhatsApp wa_id of the person booking (E.164 digits, no +)
  pickupType    CourierBookingPickupType @default(DOOR)
  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?

  recipientName    String?
  recipientPhone   String? // WhatsApp wa_id, notified on payment + status changes
  recipientAddress String?

  // Parcel list captured during the chat, e.g.
  // [{ "weightKg": 2, "description": "1-5kg" }]
  parcels Json

  serviceLevel  String? // rate card service code chosen (see src/lib/rateCards.ts)
  courier       String?
  price         Float?
  insurance     Boolean @default(false)
  scheduledDate String?
  instructions  String?

  payShapRequestId String? // reference from the PSP once Request-to-Pay is sent
  paidAt           DateTime?

  bobgoShipmentId String? // link to BobgoShipment once a real waybill is booked

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderPhone])
  @@index([status])
}

// Persists the WhatsApp conversation's current step between webhook
// deliveries (serverless functions are stateless — there's no in-memory
// option). One row per WhatsApp sender.
model WhatsAppSession {
  phone     String   @id // wa_id, digits only
  mode      String   @default("idle") // idle | booking | tracking | quoting | shopping
  step      String   @default("start")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}

enum ShoppingOrderStatus {
  DRAFT
  QUOTED
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipMethod {
  EXPRESS
  STANDARD
  ECONOMY
}

// US product shopping order: customer pastes URL, we calculate landed cost
// (item + duty + VAT + shipping), customer pays via PayFast, we import and deliver.
// Once payment cleared, links to BobgoShipment for real courier leg.
model ShoppingOrder {
  id       String              @id @default(cuid())
  orderRef String              @unique // e.g., GM-2026-1234
  status   ShoppingOrderStatus @default(DRAFT)

  // Customer info
  customerEmail       String
  customerPhone       String?
  recipientName       String
  recipientPhone      String
  recipientStreet     String
  recipientCity       String
  recipientProvince   String
  recipientPostalCode String
  recipientCountry    String  @default("ZA")

  // Product info
  productUrl    String
  productName   String?
  productPrice  Float? // USD
  productWeight Float? // kg (estimated or customer-entered)

  // Shipping choice
  shipMethod           ShipMethod @default(STANDARD)
  extraWeightSurcharge Float      @default(0) // per 0.5kg above 1kg

  // Service choices
  personalShopperFee Float @default(0) // optional concierge charge
  markupPercent      Float @default(15) // customer-chosen markup on landed cost

  // Landed-cost breakdown
  itemPriceCents    Int? // stored as cents to avoid float precision
  shippingCostCents Int? // USD base, before extra weight
  shopperFeeCents   Int?
  hsCode            String? // HS classification of product
  dutyRate          Float? // SARS duty % (e.g., 0.20 for 20%)
  dutyCents         Int? // calculated: (item + insurance + freight) * dutyRate
  vatCents          Int? // calculated: (duty + total cost) * 0.15
  landedCostCents   Int? // item + shipping + shopper fee + duty + VAT, in cents
  finalQuoteCents   Int? // landed cost + markup
  finalQuoteZar     Float? // landed cost * FX rate (cached at quote time)

  // Payment
  payFastPaymentId String?
  payFastUuid      String?
  payFastUrl       String?
  paidAt           DateTime?

  // Link to courier once paid
  bobgoShipmentId String?

  // FX rate snapshot (avoid stale rates across quote → payment)
  fxRateUsdzarSnapshot Float? // e.g., 18.5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerEmail])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Midl: escrow + courier for peer-to-peer trade. See
// /docs/BACKEND_DESIGN.md and /docs/POSTNOW_INFRA_REUSE.md in the `midl`
// repo for the full design writeup this schema implements.
// ---------------------------------------------------------------------------

enum DealPlan {
  ESSENTIALS
  STANDARD
  VERIFIED_DELIVERY
  PREMIUM_VAULT
}

// Mirrors ShoppingOrderStatus's shape (draft → funded → moving → settled)
// but as its own enum, since Midl's gates (report/dispute) don't apply to
// GlobeMe and vice versa.
enum DealState {
  DRAFT
  FUNDED
  REPORT_PENDING // item received by Midl, report being written (verified_delivery/premium_vault only)
  REPORT_ISSUED // report sent to buyer + seller, awaiting buyer response
  DISPATCHED
  DELIVERED
  RELEASED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  CANCELLED
}

enum CourierPayer {
  BUYER
  SELLER
  INCLUDED // bundled into the plan fee (standard/verified_delivery/premium_vault)
}

enum LedgerEntryType {
  HOLD
  RELEASE
  REFUND
  FEE_CAPTURE
  COURIER_CHARGE
}

enum ConditionReportStage {
  INTAKE
  PRE_DISPATCH
}

enum BuyerResponse {
  PENDING
  ACCEPTED
  FLAGGED
}

// One row per escrow deal. `plan` selects which DealState gates apply —
// see BACKEND_DESIGN.md §4 for the full transition table.
model Deal {
  id        String    @id @default(cuid())
  reference String    @unique // e.g. MIDL-7842
  plan      DealPlan
  state     DealState @default(DRAFT)

  buyerId  String
  buyer    User   @relation("DealBuyer", fields: [buyerId], references: [id])
  sellerId String
  seller   User   @relation("DealSeller", fields: [sellerId], references: [id])

  itemName       String
  itemValueCents Int
  itemCategory   String?

  // Essentials plan only; all other plans bundle courier into the fee.
  courierPayer CourierPayer @default(INCLUDED)

  feeCents       Int @default(0)
  courierCents   Int @default(0)
  insuranceCents Int @default(0)
  // Denormalized cache of SUM(LedgerEntry) for this deal — never written to
  // directly by application code; a reconciliation job derives it from
  // ledgerEntries and this column is only for cheap reads.
  totalHeldCents Int @default(0)

  pickupStreet     String?
  pickupCity       String?
  pickupProvince   String?
  pickupPostal     String?
  deliveryStreet   String
  deliveryCity     String
  deliveryProvince String
  deliveryPostal   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries    LedgerEntry[]
  conditionReports ConditionReport[]
  bobgoShipments   BobgoShipment[]
  auditEvents      AuditEvent[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([state])
}

// Append-only. Never updated or deleted; Deal.totalHeldCents is a cache
// derived from summing these, not the other way around. See
// BACKEND_DESIGN.md §3/§6 for why this has to be the source of truth.
model LedgerEntry {
  id          String          @id @default(cuid())
  dealId      String
  deal        Deal            @relation(fields: [dealId], references: [id])
  type        LedgerEntryType
  amountCents Int
  /// Reference id from the payment/trust provider (PayFast payment id in
  /// the MVP; a licensed trust-account provider's hold/release id later —
  /// see POSTNOW_INFRA_REUSE.md for why PayFast is a placeholder here, not
  /// a permanent trust account).
  providerRef String?
  createdAt   DateTime        @default(now())

  @@index([dealId])
}

// Only created for verified_delivery / premium_vault plans. The
// intake/pre_dispatch pair plus the two issuedTo timestamps are the actual
// enforcement of "buyer and seller both receive the identical report" —
// not just a UI convention.
model ConditionReport {
  id     String               @id @default(cuid())
  dealId String
  deal   Deal                 @relation(fields: [dealId], references: [id])
  stage  ConditionReportStage

  photoKeys      Json // S3 object keys
  videoUrl       String? // premium_vault only
  notes          String?
  serialNumber   String?
  functionalPass Boolean?

  issuedToBuyerAt  DateTime?
  issuedToSellerAt DateTime?
  /// Both issuedTo* timestamps must be set and the payload must match
  /// before this report can gate a DealState transition — checked at the
  /// application layer, not enforced in SQL.
  payloadHash      String?

  buyerResponse    BuyerResponse @default(PENDING)
  buyerRespondedAt DateTime?

  createdAt DateTime @default(now())

  @@index([dealId])
}
